# --------------------------------------------------------------------------
# .env.example — copy to .env locally; never commit .env
# In production, .env is regenerated on EC2 by deploy.yml from GitHub secrets.
# --------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Postgres (local + compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chikitsa360
DATABASE_URL=postgres://postgres:postgres@db:5432/chikitsa360

# Email (Gmail SMTP)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Razorpay (off in dev/staging)
RAZORPAY_ENABLED=False
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 3rd party APIs
DAILY_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Reminder cron
REMINDER_CRON_TOKEN=replace-me

# Docker Hub (used by docker-compose)
DOCKERHUB_USERNAME=
