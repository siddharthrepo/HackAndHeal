# Generated by Ansible — do not edit by hand.
# Certbot will append SSL block on first run via `--nginx`.

# Map for WebSocket upgrade — required by Django Channels
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name {{ domain_name }};

    client_max_body_size 25M;

    # Static files (collected by `collectstatic` into the static_files volume)
    location /static/ {
        alias /var/lib/docker/volumes/healthmeter_static_files/_data/;
        expires 30d;
        access_log off;
    }

    # Media (user-uploaded files: prescription PDFs etc.)
    location /media/ {
        alias /var/lib/docker/volumes/healthmeter_media_files/_data/;
        expires 7d;
        access_log off;
    }

    # WebSocket endpoints (Django Channels)
    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Everything else → daphne (HTTP under ASGI)
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
